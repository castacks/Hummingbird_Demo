# Dockerfile.pc
FROM osrf/ros:humble-desktop-full

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV TZ=America/New_York
ENV LANG=en_US.UTF-8

# ------------------ Basic tools ------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo tzdata locales \
    python3-pip python3-dev python3-wheel python3-setuptools \
    libgl1-mesa-glx libx11-6 x11-apps \
    apt-utils libopenblas-dev software-properties-common \
    gedit iputils-ping curl tmux nano vim net-tools less \
    wget unzip make cmake xz-utils gnupg2 lsb-release udev \
    build-essential jq libpq-dev zstd usbutils \
    && ln -fs /usr/share/zoneinfo/$TZ /etc/localtime \
    && dpkg-reconfigure --frontend noninteractive tzdata \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install Python packages
RUN python3 -m pip install --upgrade pip
RUN pip3 install -U protobuf jetson-stats matplotlib numpy==1.24.3 scipy wheel pymavlink pyyaml pybind11

# Install ROS2 build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-rosdep \
    python3-rosinstall \
    python3-rosinstall-generator \
    python3-vcstool \
    python3-colcon-common-extensions \
    ros-humble-mcap-vendor \
    ros-humble-rosbag2-storage-mcap \
    libasio-dev \
    ros-humble-rosbag2-test-common \
    libgeographic-dev \
    && rm -f /etc/ros/rosdep/sources.list.d/20-default.list \
    && rosdep init \
    && rosdep update \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ------------------ VINS-Fusion Dependencies ------------------
WORKDIR /tmp
RUN wget -O eigen-3.4.0.zip https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.zip \
    && unzip eigen-3.4.0.zip \
    && cd eigen-3.4.0 && mkdir build && cd build \
    && cmake ../ -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS_RELEASE="-O3 -march=native -ffast-math" -Wno-dev \
    && make install -j$(nproc)

# Install Ceres dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgoogle-glog-dev \
    libatlas-base-dev \
    libsuitesparse-dev \
    libboost-python-dev \
    libboost-dev \
    libboost-filesystem-dev \
    libboost-program-options-dev \
    libeigen3-dev \
    cmake \
    wget \
    unzip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN wget http://ceres-solver.org/ceres-solver-2.1.0.tar.gz \
    && tar zxf ceres-solver-2.1.0.tar.gz \
    && mkdir ceres-bin && cd ceres-bin \
    && cmake ../ceres-solver-2.1.0 -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS_RELEASE="-O3 -march=native -ffast-math" -Wno-dev \
    && make -j$(nproc) && make install -j$(nproc)

RUN apt-get update && apt-get install -y libyaml-cpp-dev

# ------------------ ROS2 Dependencies (MAVROS, MCAP) ------------------
WORKDIR /root/dependencies_ws/src/
RUN git clone https://github.com/JanekDev/VINS-Fusion-ROS2-humble-arm.git vins_fusion \
    && mv vins_fusion/global_fusion vins_fusion/loop_fusion vins_fusion/camera_models . \
    && rm -rf vins_fusion

WORKDIR /root/dependencies_ws/
RUN rosinstall_generator --rosdistro humble --format repos mavlink | tee /tmp/mavlink.repos \
    && rosinstall_generator --rosdistro humble --format repos --upstream mavros | tee -a /tmp/mavros.repos \
    && vcs import src < /tmp/mavlink.repos \
    && vcs import src < /tmp/mavros.repos

WORKDIR /root/dependencies_ws/src/
RUN git clone https://github.com/ros/eigen_stl_containers.git -b ros2 \
    && git clone https://github.com/ros-geographic-info/geographic_info.git -b ros2 \
    && git clone https://github.com/ros/diagnostics.git -b ros2

WORKDIR /root/dependencies_ws/src/
RUN git clone https://github.com/ros2/rosbag2.git -b humble \
    && cp -r rosbag2/rosbag2_storage_mcap/ . \
    && rm -rf rosbag2


# ------------------ Build dependencies ------------------
WORKDIR /root/dependencies_ws
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    colcon build --parallel-workers $(nproc) --symlink-install \
    --event-handlers console_direct+ --base-paths src \
    --cmake-args -Wno-dev -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS_RELEASE='-O3 -march=native -ffast-math' \
    -DCMAKE_CXX_FLAGS='-Wl,--allow-shlib-undefined' --no-warn-unused-cli"

# ------------------ ROS2 Workspace ------------------
WORKDIR /root/ros2_ws/
RUN echo "source /opt/ros/humble/install/setup.bash" >> ~/.bashrc \
    && echo "source /root/dependencies_ws/install/setup.bash" >> ~/.bashrc \
    && echo "[ -f /root/ros2_ws/install/setup.bash ] && source /root/ros2_ws/install/setup.bash" >> ~/.bashrc


# ------------------ Aliases ------------------
RUN echo "alias sws='source ~/.bashrc'" >> ~/.bashrc \
    && echo "alias bws='colcon build --symlink-install'" >> ~/.bashrc \
    && echo "alias vel_test='ros2 launch control_test vel_control_test.launch.xml'" >> ~/.bashrc \
    && echo "alias wire_test='ros2 launch control_test wire_control_test.launch.xml'" >> ~/.bashrc
